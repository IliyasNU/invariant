# PostgreSQL container and local application settings.
POSTGRES_DB=invariant
POSTGRES_USER=invariant
POSTGRES_PASSWORD=invariant
POSTGRES_HOST=localhost
# 5433 avoids colliding with a PostgreSQL server already using the standard port.
POSTGRES_PORT=5433

# Optional: when set, DATABASE_URL takes precedence over the POSTGRES_* values.
# DATABASE_URL=postgresql+psycopg://invariant:invariant@localhost:5433/invariant

# Optional GitHub integration. A token raises API limits and is required only
# when private repositories or optional PR comments are used.
GITHUB_TOKEN=
# Required only for POST /integrations/github/webhook.
GITHUB_WEBHOOK_SECRET=
# PR comments are disabled by default and also require GITHUB_TOKEN.
GITHUB_POST_PR_COMMENT=false
# Override only for GitHub Enterprise Server or local HTTP mocking.
GITHUB_API_URL=https://api.github.com
