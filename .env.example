# PostgreSQL container and local application settings.
POSTGRES_DB=invariant
POSTGRES_USER=invariant
POSTGRES_PASSWORD=invariant
POSTGRES_HOST=localhost
# 5433 avoids colliding with a PostgreSQL server already using the standard port.
POSTGRES_PORT=5433

# Optional: when set, DATABASE_URL takes precedence over the POSTGRES_* values.
# DATABASE_URL=postgresql+psycopg://invariant:invariant@localhost:5433/invariant

# The API's key: every request sends "Authorization: Bearer <key>". Generate
# one with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
INVARIANT_API_KEY=
# Or, instead of a key, for an API that only this machine can reach (the
# Compose stack publishes it on 127.0.0.1 only):
# INVARIANT_LOCAL_ONLY=true
# Browser origins allowed to call the API, comma-separated; none by default.
# INVARIANT_CORS_ORIGINS=https://invariant-ui.example.com

# Optional GitHub integration. A token raises API limits and is required only
# when private repositories or optional PR comments are used.
GITHUB_TOKEN=
# Required only for POST /integrations/github/webhook.
GITHUB_WEBHOOK_SECRET=
# PR comments are disabled by default and also require GITHUB_TOKEN.
GITHUB_POST_PR_COMMENT=false
# Optional: where this API is reachable, so that PR comments link to their run.
# INVARIANT_PUBLIC_URL=https://invariant.example.com
# Override only for GitHub Enterprise Server or local HTTP mocking.
GITHUB_API_URL=https://api.github.com

# Logs: one JSON object per line (json) or text for a terminal; and the level.
# INVARIANT_LOG_FORMAT=json
# INVARIANT_LOG_LEVEL=INFO

# The worker that runs queued GitHub analyses (python -m app.worker).
# WORKER_MAX_ATTEMPTS=3
# WORKER_LEASE_SECONDS=600
# Files not downloaded by then make the run incomplete; at most 80% of the lease.
# WORKER_JOB_SECONDS=300
# WORKER_RETRY_SECONDS=30
# WORKER_POLL_SECONDS=2
