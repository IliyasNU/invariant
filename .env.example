# PostgreSQL container and local application settings.
POSTGRES_DB=invariant
POSTGRES_USER=invariant
POSTGRES_PASSWORD=invariant
POSTGRES_HOST=localhost
# 5433 avoids colliding with a PostgreSQL server already using the standard port.
POSTGRES_PORT=5433

# Optional: when set, DATABASE_URL takes precedence over the POSTGRES_* values.
# DATABASE_URL=postgresql+psycopg://invariant:invariant@localhost:5433/invariant
